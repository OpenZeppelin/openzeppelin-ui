{
  "name": "openzeppelin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenZeppelin UI - React components and utilities for blockchain applications",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ]
  },
  "scripts": {
    "install-pnpm": "npm install -g pnpm@10.22.0",
    "install-deps": "pnpm install --frozen-lockfile --ignore-scripts --prefer-offline",
    "dev": "pnpm build && pnpm --filter=@openzeppelin/ui-example-basic-react-app dev",
    "build:dev-cli": "pnpm --filter @openzeppelin/ui-dev-cli build",
    "generate:pnpmfile": "UPDATE_PNPMFILE=1 pnpm --filter @openzeppelin/ui-dev-cli exec vitest run --config vitest.config.ts src/lib/pnpmfileTemplate.drift.test.ts",
    "build:cli": "pnpm --filter @openzeppelin/ui-cli build",
    "dev:adapters:local": "pnpm build:dev-cli && LOCAL_ADAPTERS_PATH=${LOCAL_ADAPTERS_PATH:-../openzeppelin-adapters} && LOCAL_ADAPTERS_PATH=\"$LOCAL_ADAPTERS_PATH\" oz-ui-dev use local --project \"$PWD\" --family adapters",
    "dev:local": "pnpm build:dev-cli && LOCAL_ADAPTERS_PATH=${LOCAL_ADAPTERS_PATH:-../openzeppelin-adapters} && LOCAL_ADAPTERS_PATH=\"$LOCAL_ADAPTERS_PATH\" oz-ui-dev use local --project \"$PWD\" --family adapters",
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "test": "node --test .pnpmfile.test.cjs && pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "fix-all": "pnpm format && pnpm lint:fix",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "dev:npm": "pnpm build:cli && oz-ui-dev use remote --project \"$PWD\""
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@openzeppelin/ui-dev-cli": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsdown": "^0.19.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.12.0",
  "author": "OpenZeppelin",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/openzeppelin-ui"
  }
}
