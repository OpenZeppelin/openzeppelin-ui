{
  "name": "openzeppelin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenZeppelin UI - React components and utilities for blockchain applications",
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ]
  },
  "scripts": {
    "install-pnpm": "npm install -g pnpm@10.22.0",
    "install-deps": "pnpm install --frozen-lockfile --ignore-scripts --prefer-offline",
    "dev": "pnpm build && pnpm --filter=@openzeppelin/ui-example-basic-react-app dev",
    "dev:local": "LOCAL_ADAPTERS_PATH=${LOCAL_ADAPTERS_PATH:-../ui-builder} && echo '🔨 Building local ui-builder adapter packages...' && (cd \"$LOCAL_ADAPTERS_PATH\" && pnpm --filter='./packages/adapter-*' build) && LOCAL_ADAPTERS=true pnpm install --force && echo \"✅ Using local @openzeppelin/ui-builder-adapter-* packages from $LOCAL_ADAPTERS_PATH\"",
    "dev:npm": "pnpm install --force && echo '✅ Using npm @openzeppelin/ui-builder-adapter-* packages'",
    "clean": "pnpm -r clean",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "fix-all": "pnpm format && pnpm lint:fix",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tsdown": "^0.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.22.0",
  "author": "OpenZeppelin",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/openzeppelin-ui"
  }
}
