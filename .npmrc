# Hoist wallet-connector transitive dependencies to the workspace root so Vite's
# dev-mode dependency pre-bundling can resolve them.
#
# The OpenZeppelin adapter vite fragments (getEvmViteConfig / getStellarViteConfig,
# merged by @openzeppelin/adapters-vite) declare these packages in
# `optimizeDeps.include` so dev mode gets stable CommonJS→ESM interop. Under pnpm's
# default isolated node_modules layout these transitive specifiers are not resolvable
# from the example app root, so Vite skips pre-bundling them and a lazily-imported CJS
# dependency (e.g. `eventemitter3`, pulled by @walletconnect/*) fails at runtime with
# "does not provide an export named 'default'" — the example app then fails to init.
#
# Hoisting only affects the example dev server; production builds (rollup) are
# unaffected. See examples/basic-react-app.
public-hoist-pattern[]=@wagmi/connectors
public-hoist-pattern[]=@walletconnect/*
public-hoist-pattern[]=@metamask/*
public-hoist-pattern[]=@stellar/freighter-api
public-hoist-pattern[]=eventemitter3
public-hoist-pattern[]=debug
