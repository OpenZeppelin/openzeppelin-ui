{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@styles/*": ["../styles/*"],
      "@openzeppelin/ui-types/*": ["../types/src/*"],
      "dom-accessibility-api": ["../../node_modules/dom-accessibility-api/dist/index.d.ts"]
    }
  },
  "include": ["src/components/ui/network-selector*.ts", "src/components/ui/network-selector*.tsx"],
  "exclude": ["dist", "node_modules"]
}
