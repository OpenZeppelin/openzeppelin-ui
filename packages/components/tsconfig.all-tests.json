    "src/components/ui/badge.sf14.test.tsx",
    "src/components/ui/badge.test.tsx",
    "src/components/ui/bottom-sheet/__tests__/bottom-sheet.browser.test.tsx",
    "src/components/ui/bottom-sheet/__tests__/lifecycle.sf2.test.tsx",
    "src/components/ui/bottom-sheet/__tests__/prop-state.sf2.test.tsx",
