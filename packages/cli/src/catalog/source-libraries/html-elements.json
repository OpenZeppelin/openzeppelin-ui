{
  "library": "HTML Elements",
  "importPatterns": [],
  "htmlTags": true,
  "mappings": {
    "Button": { "source": "button", "effort": "low", "notes": "Direct swap, map onClick/disabled/type" },
    "Input": { "source": "input[type=text]", "effort": "low", "notes": "type=text or no type attr" },
    "Checkbox": { "source": "input[type=checkbox]", "effort": "low", "notes": "Map checked/onChange" },
    "RadioGroup": { "source": "input[type=radio]", "effort": "medium", "notes": "Requires grouping by name attr" },
    "Select": { "source": "select", "effort": "medium", "notes": "Map option children to OZ Select items" },
    "Textarea": { "source": "textarea", "effort": "low", "notes": "Direct swap" },
    "Label": { "source": "label", "effort": "low", "notes": "Map htmlFor" },
    "Progress": { "source": "progress", "effort": "low", "notes": "Map value/max" },
    "Dialog": { "source": "dialog", "effort": "medium", "notes": "Map open attr, showModal pattern" }
  }
}
