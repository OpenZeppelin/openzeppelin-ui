{
  "library": "Radix Primitives",
  "importPatterns": ["@radix-ui/react-"],
  "namespaceImportStrategy": "package-name",
  "namespaceReportName": "target",
  "mappings": {
    "Accordion": { "source": "Accordion", "effort": "low", "notes": "Wrap swap — OZ wraps Radix internally" },
    "Checkbox": { "source": "Checkbox", "effort": "low", "notes": "Wrap swap" },
    "Dialog": {
      "source": "Dialog",
      "effort": "low",
      "notes": "Wrap swap",
      "namespaceMemberToTarget": {
        "Root": "Dialog",
        "Trigger": "DialogTrigger",
        "Portal": "__OZ_NS_UNWRAP__",
        "Overlay": "__OZ_NS_OMIT__",
        "Content": "DialogContent",
        "Title": "DialogTitle",
        "Description": "DialogDescription",
        "Close": "__OZ_NS_CLOSE_AS_CHILD__"
      }
    },
    "DropdownMenu": { "source": "DropdownMenu", "effort": "low", "notes": "Wrap swap" },
    "Label": { "source": "Label", "effort": "low", "notes": "Wrap swap" },
    "Popover": { "source": "Popover", "effort": "low", "notes": "Wrap swap" },
    "Progress": { "source": "Progress", "effort": "low", "notes": "Wrap swap" },
    "RadioGroup": { "source": "RadioGroup", "effort": "low", "notes": "Wrap swap" },
    "Select": { "source": "Select", "effort": "low", "notes": "Wrap swap" },
    "Tabs": { "source": "Tabs", "effort": "low", "notes": "Wrap swap" },
    "TabsPrimitive": { "source": "Tabs", "effort": "low", "notes": "Namespace import from @radix-ui/react-tabs", "reportName": "target" },
    "Tooltip": { "source": "Tooltip", "effort": "low", "notes": "Wrap swap" }
  }
}
