{
  "name": "@openzeppelin/ui-cli",
  "private": false,
  "version": "0.1.0",
  "description": "Consumer CLI for scaffolding, migrating, and managing OpenZeppelin UI applications.",
  "type": "module",
  "bin": {
    "oz-ui": "dist/index.mjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/catalog",
    "src/templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenZeppelin/openzeppelin-ui",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "[ \"$SKIP_PUBLISH_BUILD\" = \"true\" ] || pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "evaluate": "tsx autoresearch/evaluate.ts",
    "dashboard": "tsx autoresearch/dashboard.ts",
    "scaffold-expected": "tsx autoresearch/scaffold-expected.ts"
  },
  "keywords": [
    "openzeppelin",
    "cli",
    "react",
    "dapp",
    "migration"
  ],
  "author": "OpenZeppelin",
  "license": "AGPL-3.0",
  "dependencies": {
    "@openzeppelin/ui-tailwind-utils": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
