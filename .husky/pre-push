#!/usr/bin/env bash
set -e

echo "Running pre-push checks..."

# Try to use NVM's Node.js if available
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # Load NVM
  export NVM_DIR="$HOME/.nvm"
  \. "$NVM_DIR/nvm.sh" # This loads nvm
  
  # Use Node.js 20+ (|| true because nvm use failing is non-fatal; version check below is the gate)
  nvm use 20 >/dev/null 2>&1 || true
  
  echo "Using Node.js $(node -v) from NVM"
fi

# Require Node.js 20+ as specified in package.json
node_version=$(node -v | cut -d. -f1 | sed 's/v//')
if [ "$node_version" -lt 20 ]; then
  echo "Error: Node.js version $(node -v) is incompatible. This project requires Node.js 20.19.0+."
  echo "Push aborted. Please use Node.js 20+ for development."
  exit 1
fi

# Run formatting and linting
pnpm fix-all

# Run typecheck
echo "Running type checks..."
pnpm typecheck

# Run tests
echo "Running tests..."
pnpm test

echo "All pre-push checks passed!"
