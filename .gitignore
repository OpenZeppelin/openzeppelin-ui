# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo

# Compiled output of examples/basic-react-app/vite.config.ts. The example
# builds with `tsc -b && vite build`, and its tsconfig.node.json is a
# composite project that includes vite.config.ts -- so `tsc -b` emits these
# on every build. They were committed by accident once, and because Vite
# resolves vite.config.js ahead of vite.config.ts, the stale committed copy
# silently became the config that took effect.
examples/*/vite.config.js
examples/*/vite.config.d.ts

# Foundry (Solidity) artifacts
**/contracts/**/out/
**/contracts/**/cache/
**/contracts/**/lib/

# Cargo (Soroban/Stellar) artifacts
**/contracts/**/target/

# Coverage
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.local
.env.*.local

# Test artifacts
test-results/
packages/cli/autoresearch/

# Temporary files
*.tmp
.temp/
.pnpm-store
.vercel
/.packed-packages

# Development artifacts (maintained out-of-tree)
/artifacts/
.maestri/
